<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type='text/css' href="/style.css">
    <title>{{title}}</title>
</head>
<body>
    {{> header}}

    <main>
        <h1>{{title}}</h1>
        <p>{{message}}</p>
        
        {{#each pdfs}}
            <article class="book">
                <h2>{{this.title}}</h2>
                <p>{{this.description}}</p>
                <li><a href="/pdfs/{{this.filename}}">View PDF</a></li>

            </article>
            
        
        {{/each}}
        {{#unless pdfs}}
            <p>No PDFs found.</p>
        {{/unless}}
        
    </main>

    {{> footer}}
</body>
</html>