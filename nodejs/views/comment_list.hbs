<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <title>{{title}}</title>
</head>
<body>
  {{> header}}

  <main>
    <h1>{{title}}</h1>
    <p>{{message}}</p>
    <hr>

    {{#if comments.length}}
      {{#each comments}}
        <article class="comment">
          <p><strong>{{author}}</strong> — <em>{{createdAt}}</em></p>
          <p>
            {{previewText}}
            {{#if isTruncated}}
              <a href="/comment/{{cid}}">Read more</a>
            {{/if}}
          </p>
        </article>
        <hr>
      {{/each}}
    {{else}}
      <p>No comments yet.</p>
    {{/if}}

    <hr>
    <nav class="pagination">
      {{#if hasPrev}}
        <a href="/comments?page={{prevPage}}">← Prev</a>
      {{/if}}

      <span>Page {{page}} of {{totalPages}}</span>

      {{#if hasNext}}
        <a href="/comments?page={{nextPage}}">Next →</a>
      {{/if}}
    </nav>
  </main>

  {{> footer}}
</body>
</html>
